<?xml version="1.0" encoding="utf-8"?>
<!--
  StatusSaver manifest — the app's ID card.
  Declares: permissions, the main screen, the floating-button service, AdMob.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Floating button draws over WhatsApp -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Read WhatsApp's hidden .Statuses folders (Android 11+ needs the special screen) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- File access on older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Media access on Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Keeps the floating button alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on Android 14+ because our service type is "specialUse" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Needed on Android 13+ for the service's notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusSaver"
        android:requestLegacyExternalStorage="true">

        <!-- TODO(FAHAD): Replace with YOUR AdMob App ID before Play Store release.
             Get it from your AdMob account (apps.admob.com → your app → App settings).
             The value below is Google's SAMPLE id — it only shows test ads. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The floating download button. "specialUse" is the honest foreground-service
             type for a floating overlay button; the property tag below is required
             by Android 14+ and describes what the service does. -->
        <service
            android:name=".FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating download button for saving WhatsApp statuses" />
        </service>

        <!-- v1.1: watches the foreground window so the floating button shows
             ONLY while a WhatsApp status is playing. Reads package + activity
             class names only (canRetrieveWindowContent=false in the config —
             it cannot see any on-screen content). The user enables it manually
             in Android Settings → Accessibility → Installed apps → StatusSaver. -->
        <service
            android:name=".StatusWatcherService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
