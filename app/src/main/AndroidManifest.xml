<?xml version="1.0" encoding="utf-8"?>
<!--
  StatusSaver manifest — the app's ID card.
  Declares: permissions, the main screen, the watcher service (which also
  owns the floating button since v1.3), AdMob.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Legacy: v1–v1.2 drew the button through a foreground service with
         this permission. Since v1.3 the button is an ACCESSIBILITY
         overlay owned by StatusWatcherService and needs no overlay
         permission. Kept declared for now (harmless; the Diagnostics
         card labels it "not required since v1.3") — see BUILD_NOTES. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Read WhatsApp's hidden .Statuses folders (Android 11+ needs the special screen) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- File access on older Android versions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Media access on Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- v1.3: FOREGROUND_SERVICE, FOREGROUND_SERVICE_SPECIAL_USE and
         POST_NOTIFICATIONS were removed — they existed only for the
         retired FloatingService and its persistent notification, and
         nothing else in the app (AdMob included) needs them. -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StatusSaver"
        android:requestLegacyExternalStorage="true">

        <!-- TODO(FAHAD): Replace with YOUR AdMob App ID before Play Store release.
             Get it from your AdMob account (apps.admob.com → your app → App settings).
             The value below is Google's SAMPLE id — it only shows test ads. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v1.1: watches the foreground window (package + activity class
             names only — canRetrieveWindowContent=false in the config, so
             it cannot see any on-screen content) to show the button at the
             right moment. The user enables it manually in Android
             Settings → Accessibility → Installed apps → StatusSaver.
             v1.3: this service also OWNS the button (an accessibility
             overlay window) and the tap-to-save action — the separate
             FloatingService foreground service was retired because OEM
             battery managers killed it and Android never revived it,
             while the system keeps this watcher bound. Final spec: the
             button shows whenever WhatsApp is in the foreground; the
             status-viewer detection drives the tap and auto-save. -->
        <service
            android:name=".StatusWatcherService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
