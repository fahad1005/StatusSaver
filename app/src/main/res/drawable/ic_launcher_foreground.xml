<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon FOREGROUND (since v1.4.1): a bold white download
     arrow, drawn inside the adaptive icon's safe zone (the mark spans
     x36–72 / y28–78 of the 108-unit canvas). It is only ever rendered
     OVER @drawable/ic_launcher_background (solid WhatsApp green) —
     before v1.4.1 the manifest used this file ALONE as the icon, and
     a white arrow on transparency is a blank white tile on light
     launchers. Vector = no image files needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,28 L54,64 M40,52 L54,66 L68,52 M36,78 L72,78" />
</vector>
